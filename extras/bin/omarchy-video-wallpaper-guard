#!/bin/bash
# Keep an mpvpaper video wallpaper visible above omarchy-shell's static
# background. Usage: omarchy-video-wallpaper-guard <toggle-command>
#
# mpvpaper and the shell's "omarchy-background" surface share Hyprland's
# background layer, where the most recently mapped surface draws on top. The
# shell maps that surface again whenever it restarts (omarchy restart shell,
# a crash, a plugin bar test) and when a monitor is re-added (DisplayPort
# monitors disconnect on sleep), which buries the video under a static PNG.
# Each time it maps, wait for the shell to settle and, if the video ended up
# underneath, restart it via "<toggle-command> restart" so it maps on top again.

set -uo pipefail

TOGGLE="${1:?Usage: omarchy-video-wallpaper-guard <toggle-command>}"
SOCKET="$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock"
SETTLE_SECONDS=3

video_buried() {
  # True if any monitor's background layer lists omarchy-background after
  # mpvpaper (later in the list = drawn on top).
  hyprctl layers -j 2>/dev/null | jq -e '
    any(.[]; (.levels["0"] // []) | map(.namespace) as $ns
      | ($ns | index("mpvpaper")) as $video
      | ($ns | rindex("omarchy-background")) as $bg
      | $video != null and $bg != null and $bg > $video)' >/dev/null
}

check() {
  sleep "$SETTLE_SECONDS"
  if video_buried; then
    "$TOGGLE" restart
  fi
}

# The background may already have been re-mapped before this guard started.
check

exec {events}< <(exec socat -U - "UNIX-CONNECT:$SOCKET")
SOCAT_PID=$!
trap 'kill "$SOCAT_PID" 2>/dev/null' EXIT
trap 'exit 0' TERM INT HUP

while IFS= read -r -u "$events" event; do
  case "$event" in
    monitoraddedv2\>\>* | openlayer\>\>omarchy-background) check ;;
  esac
done
